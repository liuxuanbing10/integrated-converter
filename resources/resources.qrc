    <qresource prefix="/icons">
        <file alias="play.svg">icons/play.svg</file>
        <file alias="file.svg">icons/file.svg</file>
        <file alias="folder.svg">icons/folder.svg</file>
        <file alias="trash.svg">icons/trash.svg</file>
        <file alias="save.svg">icons/save.svg</file>
        <file alias="refresh.svg">icons/refresh.svg</file>
        <file alias="cancel.svg">icons/cancel.svg</file>
        <file alias="help.svg">icons/help.svg</file>
        <file alias="close.svg">icons/close.svg</file>
        <file alias="error.svg">icons/error.svg</file>
        <file alias="settings.svg">icons/settings.svg</file>
        <file alias="detail.svg">icons/detail.svg</file>
    </qresource>
</RCC>
